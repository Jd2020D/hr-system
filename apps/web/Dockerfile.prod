# Stage 1: Build
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package.json first (required)
COPY package.json ./

# Copy package-lock.json if it exists (optional)
COPY package-lock.json* ./

# Install dependencies (use npm ci if lock file exists, otherwise npm install)
RUN if [ -f package-lock.json ]; then \
      npm ci && npm cache clean --force; \
    else \
      npm install && npm cache clean --force; \
    fi

# Copy source code
COPY . .

# Build the application
# Skip TypeScript check and run vite build directly (Vite handles TypeScript transpilation)
RUN npx vite build

# Stage 2: Production with Nginx
FROM nginx:alpine

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
